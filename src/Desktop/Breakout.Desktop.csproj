<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Breakout</RootNamespace>
    <AssemblyName>BricksBreaker</AssemblyName>
    <Title>Bricks Breaker</Title>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <UseSource>false</UseSource>
    <DefineConstants>$(DefineConstants);DESKTOP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.ico" />
  </ItemGroup>

  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <!-- AppSettings stores desktop settings with reflection-based System.Text.Json, trimmed publish turns it off -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Windows screen-reader support (UI Automation) is COM interop, trimmed publish turns it off -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- OpenTK uses reflection to load GL bindings — must not be trimmed -->
  <!-- SkiaSharp font/image APIs are called via non-obvious paths and get cut by TrimMode=full -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="OpenTK.Graphics" />
    <TrimmerRootAssembly Include="OpenTK.Windowing.Desktop" />
    <TrimmerRootAssembly Include="SkiaSharp" />
    <TrimmerRootAssembly Include="HarfBuzzSharp" />
    <!-- its UI Automation COM interfaces are implemented for native callers, trimming breaks their layout -->
    <TrimmerRootAssembly Include="DrawnUi.OpenTk" />
  </ItemGroup>

  <!-- Strip PDB files from publish output -->
  <Target Name="ExcludePdbsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <Import Project="../Shared/Breakout.Shared.projitems" Label="Shared" />

  <ItemGroup>
    <ProjectReference Include="..\Common\Breakout.Common.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSource)' == 'true'">
    <ProjectReference Include="..\..\..\DrawnUi\src\OpenTk\Addons\DrawnUi.OpenTk.Game\DrawnUi.OpenTk.Game.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSource)' != 'true'">
    <PackageReference Include="DrawnUi.OpenTk.Game" Version="1.10.8.20" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Mobile\Resources\Fonts\**">
      <Link>fonts\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Mobile\Resources\Raw\**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="..\Mobile\Resources\Raw\AboutAssets.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Miniaudio.Net" Version="0.2.0" />
    <!-- Required for Linux publish to include native Skia runtime -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" />
  </ItemGroup>

</Project>
